# ==============================================================================
# OpenKuasaOS - .gitignore (Laravel, Credentials, Sample Data, & Environment)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Laravel Framework & Generated Assets
# ------------------------------------------------------------------------------
/vendor/
/node_modules/
/public/build/
/public/hot
/public/storage

# Storage directories and cached runtime files
/storage/*.key
/storage/app/*
!/storage/app/
!/storage/app/.gitignore
!/storage/app/public/
!/storage/app/public/.gitignore
!/storage/app/private/
!/storage/app/private/.gitignore

/storage/framework/cache/*
!/storage/framework/cache/.gitignore
!/storage/framework/cache/data/
!/storage/framework/cache/data/.gitignore
!/storage/framework/cache/locks/
!/storage/framework/cache/locks/.gitignore

/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore

/storage/framework/testing/*
!/storage/framework/testing/.gitignore

/storage/framework/views/*
!/storage/framework/views/.gitignore

/storage/logs/*
!/storage/logs/.gitignore

# Bootstrap compiled cache
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# ------------------------------------------------------------------------------
# 2. Credentials, Secrets & Private Keys (PASTIKAN TIADA KREDENTIAL DI-UPLOAD)
# ------------------------------------------------------------------------------
# Environment configuration files
.env
.env.*
!.env.example
!.env.example.*
.env.backup
.env.production
.env.production.local
.env.staging
.env.local
.env.development.local
.env.test.local

# Private keys, certificates, and auth tokens
*.key
*.pem
*.crt
*.cer
*.der
*.p12
*.pfx
oauth-private.key
oauth-public.key
id_rsa*
id_ed25519*
id_ecdsa*
id_dsa*

# Composer / NPM / Package manager authentication
auth.json
.npmrc
.yarnrc

# API tokens, secret credentials, service accounts
credentials.json
client_secret*.json
service-account*.json
firebase-adminsdk*.json
*credentials*.json
*secret*.json
*.secret
*.secrets
.secrets
secrets/
.credentials/
credentials/
token.json
tokens.json
*.token
master.key
jwt.secret

# Cloud provider CLI credentials
.aws/
.azure/
.gcp/
gcloud/

# ------------------------------------------------------------------------------
# 3. Sample Data, Database Dumps & User Uploads (PASTIKAN TIADA DATA SAMPLE)
# ------------------------------------------------------------------------------
# SQLite databases & journals
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
*.db-journal
database.sqlite
database/*.sqlite*
database/*.db*

# Database dumps, backups & exports
*.sql
!database/migrations/*.sql
!supabase/migrations/*.sql
!supabase/tests/*.sql
*.sql.gz
*.sql.zip
*.sql.tar.gz
*.dump
*.dump.*
*.bak
*.backup
*.rdb
/dumps/
/backups/
/storage/dumps/
database/dumps/

# Sample data & dummy data folders/files
sample_data/
sample-data/
data_sample/
data-sample/
dummy_data/
dummy-data/
mock_data/
mock-data/
sample_files/
sample-files/
fixtures/uploads/
fixtures/downloads/
fixtures/temp/

# Raw data exports & spreadsheets
*.csv
*.tsv
*.xlsx
*.xls

# User uploads and attachment directories
/public/uploads/
/public/files/
storage/app/receipts/*
storage/app/invoices/*
storage/app/cv/*
storage/app/resumes/*
storage/app/avatars/*
storage/app/documents/*
storage/app/letters/*

# ------------------------------------------------------------------------------
# 4. Testing, Logs & Debugging
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.phpunit.result.cache
.phpunit.cache
/coverage
/evals/reports

# Python / Pytest
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# ------------------------------------------------------------------------------
# 5. Build, Bundler & Package Managers (Yarn / Next.js / TypeScript)
# ------------------------------------------------------------------------------
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
.vercel
.netlify

# ------------------------------------------------------------------------------
# 6. IDE, Operating System & Personal Tooling
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
.claude/settings.local.json
.mcp.json
.superpowers/
.playwright-mcp/
docs/superpowers/
Homestead.json
Homestead.yaml
